{
  "name": "@mathgo/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Access tokens and the online-play rules shared by api and game-server.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
