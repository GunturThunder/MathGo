{
  "name": "@mathgo/game-core",
  "version": "0.0.0",
  "private": true,
  "description": "Seeded RNG, question generator, battle rules and trophy maths. Pure TypeScript, shared by the app and the servers.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@mathgo/config": "workspace:*",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
