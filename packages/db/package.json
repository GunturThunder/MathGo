{
  "name": "@mathgo/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema and migrations for Postgres.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "migrate": "node dist/migrate-cli.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@mathgo/config": "workspace:*",
    "@types/node": "26.6.3",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9"
  }
}
