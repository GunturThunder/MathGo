{
  "name": "@mathgo/game-server",
  "version": "0.0.0",
  "private": true,
  "description": "Colyseus game server: matchmaking and battle rooms.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.4",
    "@colyseus/testing": "0.18.6",
    "@colyseus/tools": "0.18.7",
    "@mathgo/battle-client": "workspace:*",
    "@mathgo/config": "workspace:*",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.34",
    "@colyseus/ws-transport": "0.18.4",
    "@mathgo/auth": "workspace:*",
    "@mathgo/game-core": "workspace:*",
    "@mathgo/protocol": "workspace:*",
    "zod": "4.6.5"
  }
}
