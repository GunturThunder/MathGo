{
  "name": "mathgo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "turbo run build --filter=@mathgo/db --output-logs=errors-only && node --env-file-if-exists=.env packages/db/dist/migrate-cli.js",
    "review:too-fast": "turbo run build --filter=@mathgo/db --output-logs=errors-only && node --env-file-if-exists=.env packages/db/dist/review-cli.js"
  },
  "prettier": "@mathgo/config/prettier",
  "devDependencies": {
    "@mathgo/config": "workspace:*",
    "prettier": "3.9.9",
    "turbo": "2.11.5"
  }
}
