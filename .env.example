# Copy to .env to change the local defaults. docker compose and `pnpm db:migrate` read it.
POSTGRES_USER=mathgo
POSTGRES_PASSWORD=mathgo
POSTGRES_DB=mathgo
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgres://mathgo:mathgo@localhost:5432/mathgo
REDIS_URL=redis://localhost:6379
API_PORT=3000
API_LOG_LEVEL=info
# Signs access tokens; api and game-server must share it. At least 32 characters.
JWT_SECRET=local-compose-jwt-secret-not-for-production
# Keys the hashes of parents' phone numbers and consent codes (S5-05). At least 32 characters.
CONSENT_SECRET=local-compose-consent-secret-not-for-production
GAME_SERVER_PORT=2567
